# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is in .gitignore.

# MongoDB Atlas connection string
MONGO_URI=

# Port the Express server listens on
PORT=5000

# JWT signing secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=

# Secret used to generate secure QR tokens
QR_SECRET=

# Pre-shared key required by the hardware simulator
SIMULATOR_KEY=

# URL of the React dev server (used for CORS)
CLIENT_URL=http://localhost:5173
